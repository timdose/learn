<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Light Zones</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #000; overflow: hidden; }
    canvas { display: block; width: 100vw; height: 100vh; }
    #back {
      position: fixed;
      top: 1rem;
      left: 1rem;
      color: #888;
      font: 13px/1 sans-serif;
      text-decoration: none;
      z-index: 10;
    }
    #back:hover { color: #fff; }
    #axes-legend {
      position: fixed;
      bottom: 0.5rem;
      left: 0.5rem;
      font: 11px/1.8 monospace;
      pointer-events: none;
    }
    #axes-legend span { font-weight: bold; }
  </style>
</head>
<body>
  <a id="back" href="/demos/">← Demos</a>
  <canvas id="demo-canvas"></canvas>
  <div id="axes-legend">
    <span style="color:#ff4444">X</span>
    <span style="color:#44ff44">Y</span>
    <span style="color:#4488ff">Z</span>
  </div>

  <script>
    import * as THREE from 'three';
    import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
    import { Line2 } from 'three/examples/jsm/lines/Line2.js';
    import { LineGeometry } from 'three/examples/jsm/lines/LineGeometry.js';
    import { LineMaterial } from 'three/examples/jsm/lines/LineMaterial.js';

    const canvas = document.getElementById('demo-canvas') as HTMLCanvasElement;

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    renderer.setPixelRatio(window.devicePixelRatio);

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x000000);

    // Sphere at origin, light directly above at y=10
    // Camera pulled back on Z, shifted up so both are in frame
    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 200);
    camera.position.set(0, 6, 22);

    // Sphere — flat, no shading
    const sphere = new THREE.Mesh(
      new THREE.SphereGeometry(1.5, 64, 64),
      new THREE.MeshBasicMaterial({ color: 0x333333 })
    );
    scene.add(sphere);

    // Light position and visible marker
    const lightPos = new THREE.Vector3(0, 10, 0);
    const lightMarker = new THREE.Mesh(
      new THREE.SphereGeometry(0.12, 16, 16),
      new THREE.MeshBasicMaterial({ color: 0xffffff })
    );
    lightMarker.position.copy(lightPos);
    scene.add(lightMarker);

    // Single interactive ray (Line2 for variable linewidth)
    const raycaster = new THREE.Raycaster();

    const rayGeom = new LineGeometry();
    rayGeom.setPositions([0, 10, 0, 0, 10, 0]); // placeholder
    const rayMat = new LineMaterial({
      color: 0x555555,
      linewidth: 2,
      resolution: new THREE.Vector2(window.innerWidth, window.innerHeight),
    });
    const rayLine = new Line2(rayGeom, rayMat);
    scene.add(rayLine);

    let currentHit: THREE.Vector3 | null = null;

    function updateRay(dir: THREE.Vector3) {
      raycaster.set(lightPos, dir);
      const hits = raycaster.intersectObject(sphere);
      const end = hits.length > 0
        ? hits[0].point
        : lightPos.clone().addScaledVector(dir, 15);
      rayGeom.setPositions([
        lightPos.x, lightPos.y, lightPos.z,
        end.x, end.y, end.z,
      ]);
      rayMat.color.setHex(hits.length > 0 ? 0xffffff : 0x555555);
      currentHit = hits.length > 0 ? hits[0].point.clone() : null;
    }

    const dotMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
    const dotGeo = new THREE.SphereGeometry(0.05, 16, 16);

    window.addEventListener('click', () => {
      if (!currentHit) return;
      const dot = new THREE.Mesh(dotGeo, dotMat);
      dot.position.copy(currentHit);
      scene.add(dot);
    });

    // Default: straight down toward sphere
    updateRay(new THREE.Vector3(0, -1, 0));

    window.addEventListener('mousemove', (e) => {
      // Joystick mapping: distance from screen center → polar angle,
      // direction on screen → azimuth.
      // X offset tilts in world X; Y offset tilts in world Z (depth).
      const ndcX =  (e.clientX / window.innerWidth)  * 2 - 1;
      const ndcY = -(e.clientY / window.innerHeight) * 2 + 1;

      const scale = 1.5;
      const tx = ndcX * scale;  // tilt toward ±X
      const tz = -ndcY * scale; // tilt toward ±Z (inverted: up on screen = away from viewer)

      const polar   = Math.min(Math.sqrt(tx * tx + tz * tz), Math.PI * 0.85);
      const azimuth = polar > 0.001 ? Math.atan2(tx, tz) : 0;
      const sinP    = Math.sin(polar);

      updateRay(new THREE.Vector3(
        sinP * Math.sin(azimuth),
        -Math.cos(polar),
        sinP * Math.cos(azimuth),
      ));
    });

    // OrbitControls — target the midpoint of sphere + light
    const controls = new OrbitControls(camera, canvas);
    controls.target.set(0, 5, 0);
    controls.enableDamping = true;
    controls.update();

    function setSize() {
      const w = window.innerWidth;
      const h = window.innerHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      rayMat.resolution.set(w, h);
    }

    setSize();
    window.addEventListener('resize', setSize);

    // Corner axes gizmo
    const axesScene = new THREE.Scene();
    axesScene.add(new THREE.AxesHelper(1));
    const axesCamera = new THREE.PerspectiveCamera(50, 1, 0.1, 10);
    axesCamera.position.set(0, 0, 3);

    const GIZMO = 100; // px

    function animate() {
      requestAnimationFrame(animate);
      controls.update();

      // Main scene — full viewport
      renderer.setScissorTest(false);
      renderer.setViewport(0, 0, window.innerWidth, window.innerHeight);
      renderer.render(scene, camera);

      // Axes inset — bottom-left corner
      axesCamera.quaternion.copy(camera.quaternion);
      renderer.setScissorTest(true);
      renderer.setScissor(0, 0, GIZMO, GIZMO);
      renderer.setViewport(0, 0, GIZMO, GIZMO);
      renderer.render(axesScene, axesCamera);
      renderer.setScissorTest(false);
    }
    animate();
  </script>
</body>
</html>
