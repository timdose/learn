<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Light Zones</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #000; overflow: hidden; font-family: sans-serif; }
    canvas { display: block; width: 100vw; height: 100vh; }

    #back {
      position: fixed; top: 1rem; left: 1rem;
      color: #666; font: 13px/1 sans-serif; text-decoration: none; z-index: 10;
    }
    #back:hover { color: #fff; }

    /* ── Controls panel ── */
    #panel {
      position: fixed; bottom: 1rem; right: 1rem;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 8px;
      padding: 0.75rem 1rem;
      color: #ccc;
      font-size: 12px;
      line-height: 1.9;
      min-width: 210px;
      z-index: 10;
    }
    #panel h3 { color: #fff; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.4rem; display: flex; align-items: center; justify-content: space-between; cursor: pointer; user-select: none; }
    #panel h3:hover { color: #ddd; }
    #panel-toggle { color: #888; font-size: 13px; pointer-events: none; }
    #panel.collapsed { min-width: 0; padding-bottom: 0.75rem; }
    #panel.collapsed > *:not(h3) { display: none; }
    #panel.collapsed h3{ margin-bottom: 0; }
    #panel hr { border: none; border-top: 1px solid rgba(255,255,255,0.1); margin: 0.5rem 0; }
    .row { display: flex; align-items: center; gap: 0.5rem; }
    .row label { flex: 1; }
    kbd {
      display: inline-block; padding: 1px 5px;
      border: 1px solid #555; border-radius: 3px;
      font: 11px monospace; color: #bbb; background: rgba(255,255,255,0.06);
    }
    .val-input {
      width: 50px; background: rgba(255,255,255,0.08); border: 1px solid #555;
      border-radius: 4px; color: #fff; font-size: 12px; text-align: center;
      padding: 1px 4px; -moz-appearance: textfield;
    }
    .val-input::-webkit-outer-spin-button,
    .val-input::-webkit-inner-spin-button { -webkit-appearance: none; }
    .val-input:focus { outline: none; border-color: #888; }
    .val-unit { color: #777; font-size: 11px; }
    .val-slider { width: 100%; margin: 2px 0 6px; accent-color: #777; cursor: pointer; }
    #terminator-btn {
      width: 100%; margin-top: 0.25rem; padding: 4px 0;
      border: 1px solid #555; border-radius: 4px;
      background: rgba(255,255,255,0.06); color: #ccc; cursor: pointer; font-size: 12px;
    }
    #terminator-btn:hover { background: rgba(255,255,255,0.14); color: #fff; }
    #terminator-btn.active { border-color: #ff8c42; color: #ff8c42; background: rgba(255,140,66,0.1); }
    #clear-btn {
      width: 100%; margin-top: 0.25rem; padding: 4px 0;
      border: 1px solid #555; border-radius: 4px;
      background: rgba(255,255,255,0.06); color: #ccc; cursor: pointer; font-size: 12px;
    }
    #clear-btn:hover { background: rgba(255,60,60,0.15); color: #f88; border-color: #f66; }
    #trace-btn {
      width: 100%; margin-top: 0.25rem; padding: 4px 0;
      border: 1px solid #555; border-radius: 4px;
      background: rgba(255,255,255,0.06); color: #ccc; cursor: pointer; font-size: 12px;
    }
    #trace-btn:hover { background: rgba(255,255,255,0.14); color: #fff; }
    #trace-btn.active { border-color: #ff8c42; color: #ff8c42; background: rgba(255,140,66,0.1); }
    #labels-btn {
      width: 100%; margin-top: 0.25rem; padding: 4px 0;
      border: 1px solid #555; border-radius: 4px;
      background: rgba(255,255,255,0.06); color: #ccc; cursor: pointer; font-size: 12px;
    }
    #labels-btn:hover { background: rgba(255,255,255,0.14); color: #fff; }
    #labels-btn.active { border-color: #aaa; color: #fff; background: rgba(255,255,255,0.1); }
    #ground-btn {
      width: 100%; margin-top: 0.25rem; padding: 4px 0;
      border: 1px solid #555; border-radius: 4px;
      background: rgba(255,255,255,0.06); color: #ccc; cursor: pointer; font-size: 12px;
    }
    #ground-btn:hover { background: rgba(255,255,255,0.14); color: #fff; }
    #ground-btn.active { border-color: #aaa; color: #fff; background: rgba(255,255,255,0.1); }
    #zone-labels { position: fixed; inset: 0; pointer-events: none; }
    .zone-label {
      position: absolute; transform: translate(-50%, -50%);
      color: #fff; font: 11px/1 sans-serif; letter-spacing: 0.06em; text-transform: uppercase;
      white-space: nowrap;
      background: rgba(0,0,0,0.55); padding: 2px 7px; border-radius: 3px;
      opacity: 0; transition: opacity 0.3s;
    }
    .zone-label.visible { opacity: 1; }

  </style>
</head>
<body>
  <a id="back" href="/demos/">← Demos</a>

  <div id="zone-labels">
    <div class="zone-label" id="lbl-light">Zone of Light</div>
    <div class="zone-label" id="lbl-term">Terminator</div>
    <div class="zone-label" id="lbl-shadow">Zone of Shadow</div>
    <div class="zone-label" id="lbl-cast">Cast Shadow</div>
  </div>

  <canvas id="demo-canvas"></canvas>

  <div id="panel" class="collapsed">
    <h3>Controls &nbsp;<span id="panel-toggle">▴</span></h3>
    <div><kbd>Mouse</kbd> Aim ray</div>
    <div><kbd>↑↓←→</kbd> Nudge &nbsp;<kbd>Shift+↑↓←→</kbd> Fine nudge</div>
    <div><kbd>Click</kbd> / <kbd>Space</kbd> Place dot(s)</div>
    <div><kbd>[</kbd> <kbd>]</kbd> Spray count &nbsp;<kbd>,</kbd> <kbd>.</kbd> Spread</div>
    <div><kbd>T</kbd> Trace terminator &nbsp;<kbd>Esc</kbd> Stop</div>
    <div><kbd>L</kbd> Labels &nbsp;<kbd>G</kbd> Ground</div>
    <div><kbd>Right-drag</kbd> Orbit camera</div>
    <hr />
    <div class="row">
      <label>Spray count</label>
      <input type="number" class="val-input" id="spray-val" value="1" min="1" max="1000">
    </div>
    <input type="range" class="val-slider" id="spray-slider" min="1" max="100" step="1" value="1">
    <div class="row">
      <label>Spray spread</label>
      <input type="number" class="val-input" id="spread-val" value="5" min="1" max="90"><span class="val-unit">°</span>
    </div>
    <input type="range" class="val-slider" id="spread-slider" min="1" max="90" step="1" value="5">
    <hr />
    <button id="trace-btn">T — Trace terminator</button>
    <button id="labels-btn">L — Show labels</button>
    <button id="ground-btn">G — Show ground</button>
    <button id="clear-btn">C — Clear dots</button>
  </div>

  <script>
    import * as THREE from 'three';
    import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
    import { Line2 } from 'three/examples/jsm/lines/Line2.js';
    import { LineGeometry } from 'three/examples/jsm/lines/LineGeometry.js';
    import { LineMaterial } from 'three/examples/jsm/lines/LineMaterial.js';

    // ── Renderer ──────────────────────────────────────────────────────────────
    const canvas = document.getElementById('demo-canvas') as HTMLCanvasElement;
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.localClippingEnabled = true;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x000000);

    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 200);
    camera.position.set(0, 6, 22);

    // ── Scene objects ─────────────────────────────────────────────────────────
    const SPHERE_RADIUS = 1.5;
    const sphere = new THREE.Mesh(
      new THREE.SphereGeometry(SPHERE_RADIUS, 128, 128),
      new THREE.MeshBasicMaterial({ color: 0x333333 })
    );
    scene.add(sphere);

    const lightPos = new THREE.Vector3(0, 10, 0);
    const lightMarker = new THREE.Mesh(
      new THREE.SphereGeometry(0.12, 16, 16),
      new THREE.MeshBasicMaterial({ color: 0xffffff })
    );
    lightMarker.position.copy(lightPos);
    scene.add(lightMarker);

    // ── Ray ───────────────────────────────────────────────────────────────────
    const raycaster = new THREE.Raycaster();
    const picker    = new THREE.Raycaster();
    const mouse     = new THREE.Vector2();
    const rayGeom = new LineGeometry();
    rayGeom.setPositions([0, 10, 0, 0, 10, 0]);
    const rayMat = new LineMaterial({
      color: 0x555555, linewidth: 2,
      resolution: new THREE.Vector2(window.innerWidth, window.innerHeight),
    });
    scene.add(new Line2(rayGeom, rayMat));

    function updateRay(dir: THREE.Vector3) {
      raycaster.set(lightPos, dir.normalize());
      const hits = raycaster.intersectObject(sphere);
      const hit = hits.length > 0;
      const end = hit ? hits[0].point : lightPos.clone().addScaledVector(dir, 15);
      rayGeom.setPositions([lightPos.x, lightPos.y, lightPos.z, end.x, end.y, end.z]);
      rayMat.color.setHex(hit ? 0xffffff : 0x555555);
    }

    // ── Aim state ─────────────────────────────────────────────────────────────
    let azimuth = 0;   // rotation around Y
    let polar    = 0;  // tilt from straight-down (0 = down, π/2 = horizontal)

    function dirFromAngles(az: number, pol: number): THREE.Vector3 {
      const s = Math.sin(pol);
      return new THREE.Vector3(s * Math.sin(az), -Math.cos(pol), s * Math.cos(az));
    }

    function anglesFromDir(dir: THREE.Vector3): { az: number; pol: number } {
      const d = dir.clone().normalize();
      const pol = Math.acos(Math.max(-1, Math.min(1, -d.y)));
      const az  = pol > 0.001 ? Math.atan2(d.x, d.z) : azimuth;
      return { az, pol };
    }

    function applyDir() { updateRay(dirFromAngles(azimuth, polar)); }
    applyDir();

    // Shared picking logic — used by both mouse and arrow keys
    let virtualX = window.innerWidth  / 2;
    let virtualY = window.innerHeight / 2;

    function aimFromScreen(cx: number, cy: number) {
      mouse.set(
        (cx / window.innerWidth)  * 2 - 1,
       -(cy / window.innerHeight) * 2 + 1
      );
      picker.setFromCamera(mouse, camera);
      const sphereHits = picker.intersectObject(sphere);
      let target: THREE.Vector3;
      if (sphereHits.length > 0) {
        target = sphereHits[0].point;
      } else if (groundVisible) {
        const gHits = picker.intersectObject(groundMesh);
        if (gHits.length > 0) {
          target = gHits[0].point;
        } else {
          const camForward = new THREE.Vector3();
          camera.getWorldDirection(camForward);
          const plane = new THREE.Plane().setFromNormalAndCoplanarPoint(camForward, sphere.position);
          target = new THREE.Vector3();
          if (!picker.ray.intersectPlane(plane, target)) return;
        }
      } else {
        const camForward = new THREE.Vector3();
        camera.getWorldDirection(camForward);
        const plane = new THREE.Plane().setFromNormalAndCoplanarPoint(camForward, sphere.position);
        target = new THREE.Vector3();
        if (!picker.ray.intersectPlane(plane, target)) return;
      }
      const { az, pol } = anglesFromDir(target.clone().sub(lightPos));
      azimuth = az;
      polar   = pol;
      applyDir();
    }

    window.addEventListener('mousemove', (e) => {
      if (e.buttons === 2) return;
      if (traceAnim) return;
      virtualX = e.clientX;
      virtualY = e.clientY;
      aimFromScreen(virtualX, virtualY);
    });

    window.addEventListener('keydown', (e) => {
      const px = e.shiftKey ? 1 : 8;
      switch (e.key) {
        case 'ArrowLeft':  virtualX = Math.max(0,                    virtualX - px); break;
        case 'ArrowRight': virtualX = Math.min(window.innerWidth,    virtualX + px); break;
        case 'ArrowUp':    virtualY = Math.max(0,                    virtualY - px); break;
        case 'ArrowDown':  virtualY = Math.min(window.innerHeight,   virtualY + px); break;
        case ' ': e.preventDefault(); if (!e.repeat) startHold(); return;
        case '[': case '{': adjustCount(e.shiftKey ? -10 : -1);  return;
        case ']': case '}': adjustCount(e.shiftKey ?  10 :  1);  return;
        case ',': case '<': adjustSpread(e.shiftKey ? -10 : -1); return;
        case '.': case '>': adjustSpread(e.shiftKey ?  10 :  1); return;
        case 't': case 'T': startTrace(); return;
        case 'l': case 'L': toggleLabels(); return;
        case 'g': case 'G': toggleGround(); return;
        case 'h': case 'H': togglePanel(); return;
        case 'c': case 'C': clearDots(); return;
        case 'Escape': stopTrace(); return;
        default: return;
      }
      e.preventDefault();
      aimFromScreen(virtualX, virtualY);
    });

    // ── Dots ─────────────────────────────────────────────────────────────────
    const dotGeo = new THREE.SphereGeometry(0.035, 16, 16);
    const dotMat = new THREE.MeshBasicMaterial({ color: 0xffffff});
    const dots: THREE.Mesh[] = [];

    let sprayCount  = 1;
    let spraySpread = 5 * (Math.PI / 180); // degrees → radians

    function placeDot(pos: THREE.Vector3) {
      const dot = new THREE.Mesh(dotGeo, dotMat);
      dot.position.copy(pos);
      scene.add(dot);
      dots.push(dot);
    }

    function clearDots() {
      dots.forEach(d => scene.remove(d));
      dots.length = 0;
    }

    // Sample a random direction uniformly within a cone around `dir`.
    function sampleCone(dir: THREE.Vector3, halfAngle: number): THREE.Vector3 {
      const phi      = 2 * Math.PI * Math.random();
      const cosTheta = 1 - Math.random() * (1 - Math.cos(halfAngle));
      const sinTheta = Math.sqrt(1 - cosTheta * cosTheta);
      const local    = new THREE.Vector3(sinTheta * Math.cos(phi), sinTheta * Math.sin(phi), cosTheta);
      const q        = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 0, 1), dir.clone().normalize());
      return local.applyQuaternion(q);
    }

    canvas.addEventListener('click', (e) => {
      // Intercept clicks on the gizmo area (top-right corner)
      if (e.clientX >= window.innerWidth - GIZMO && e.clientY < GIZMO) {
        const localX = e.clientX - (window.innerWidth - GIZMO);
        const ndcX   = (localX / GIZMO) * 2 - 1;
        const ndcY   = -((e.clientY / GIZMO) * 2 - 1);
        const gizmoPick = new THREE.Raycaster();
        gizmoPick.setFromCamera(new THREE.Vector2(ndcX, ndcY), axesCamera);
        const hits = gizmoPick.intersectObject(gizmoSphere, true); // recursive = picks caps too
        if (hits.length > 0) {
          let face: string;
          if (hits[0].object === topCap) {
            face = 'top';
          } else if (hits[0].object === bottomCap) {
            face = 'bottom';
          } else if (hits[0].face) {
            const n = hits[0].face.normal;
            const ax = Math.abs(n.x), ay = Math.abs(n.y), az = Math.abs(n.z);
            if (ax >= ay && ax >= az)      face = n.x > 0 ? 'right' : 'left';
            else if (ay >= ax && ay >= az) face = n.y > 0 ? 'top'   : 'bottom';
            else                           face = n.z > 0 ? 'front' : 'back';
          } else { return; }
          snapToView(face);
        }
        return;
      }

      if (traceAnim) return;
      if (autoFired) { autoFired = false; return; } // already fired via hold
      fireDots();
    });

    // ── Hold-to-fire ─────────────────────────────────────────────────────────
    function fireDots() {
      if (traceAnim) return;
      const primaryDir = dirFromAngles(azimuth, polar);
      const dirs: THREE.Vector3[] = [primaryDir];
      for (let i = 1; i < sprayCount; i++) dirs.push(sampleCone(primaryDir, spraySpread));
      dirs.forEach(dir => {
        raycaster.set(lightPos, dir.normalize());
        const hits = raycaster.intersectObject(sphere);
        if (hits.length > 0) {
          placeDot(hits[0].point.clone());
        } else if (groundVisible) {
          const gHits = raycaster.intersectObject(groundMesh);
          if (gHits.length > 0) placeDot(gHits[0].point.clone());
        }
      });
    }

    let holdTimer: number | null = null;
    let autoFired = false;

    function startHold() {
      if (holdTimer !== null || traceAnim) return;
      holdTimer = window.setInterval(() => { autoFired = true; fireDots(); }, 100);
    }
    function stopHold() {
      if (holdTimer === null) return;
      window.clearInterval(holdTimer);
      holdTimer = null;
    }

    canvas.addEventListener('mousedown', (e) => {
      if (e.button !== 0) return;
      if (e.clientX >= window.innerWidth - GIZMO && e.clientY < GIZMO) return;
      startHold();
    });
    window.addEventListener('mouseup',   (e) => { if (e.button === 0) stopHold(); });
    window.addEventListener('mouseleave', stopHold);
    window.addEventListener('keyup', (e) => { if (e.key === ' ') stopHold(); });

    // Suppress context menu so right-click drag works cleanly
    canvas.addEventListener('contextmenu', e => e.preventDefault());

    // ── Terminator ring ───────────────────────────────────────────────────────
    // The terminator is where a ray from the light is tangent to the sphere.
    // Mathematically: the intersection of the sphere with the plane L·P = r².
    const lightDir = lightPos.clone().normalize();
    const planeDist = (SPHERE_RADIUS * SPHERE_RADIUS) / lightPos.length();
    const ringCenter = lightDir.clone().multiplyScalar(planeDist);
    const ringRadius = Math.sqrt(SPHERE_RADIUS * SPHERE_RADIUS - planeDist * planeDist);

    // Two vectors perpendicular to lightDir=(0,1,0): use X and Z axes
    const termU = new THREE.Vector3(1, 0, 0);
    const termV = new THREE.Vector3(0, 0, 1);

    const TERM_SEGMENTS = 128;
    const termPts: number[] = [];
    for (let i = 0; i <= TERM_SEGMENTS; i++) {
      const a = (i / TERM_SEGMENTS) * Math.PI * 2;
      const p = ringCenter.clone()
        .addScaledVector(termU, Math.cos(a) * ringRadius)
        .addScaledVector(termV, Math.sin(a) * ringRadius);
      termPts.push(p.x, p.y, p.z);
    }

    const termGeom = new LineGeometry();
    termGeom.setPositions(termPts);
    const termMat = new LineMaterial({
      color: 0xff8c42, linewidth: 2,
      transparent: true, opacity: 0,
      resolution: new THREE.Vector2(window.innerWidth, window.innerHeight),
    });
    const termLine = new Line2(termGeom, termMat);
    termLine.visible = false;
    scene.add(termLine);

    let termFadeTarget = 0; // 0 = hidden, 1 = visible

    // ── Zone highlights ───────────────────────────────────────────────────────
    const zoneGeo = new THREE.SphereGeometry(SPHERE_RADIUS * 1.003, 64, 64);
    const lightZone = new THREE.Mesh(zoneGeo, new THREE.MeshBasicMaterial({
      color: 0xdddddd, transparent: true, opacity: 0.25, depthWrite: false,
      clippingPlanes: [new THREE.Plane(new THREE.Vector3(0, 1, 0), -planeDist)],
    }));
    const shadowZone = new THREE.Mesh(zoneGeo, new THREE.MeshBasicMaterial({
      color: 0x000000, transparent: true, opacity: 0.5, depthWrite: false,
      clippingPlanes: [new THREE.Plane(new THREE.Vector3(0, -1, 0), planeDist)],
    }));
    lightZone.visible = false;
    shadowZone.visible = false;
    scene.add(lightZone);
    scene.add(shadowZone);

    // ── Ground plane + cast shadow ────────────────────────────────────────────
    // Shadow radius: extend the terminator tangent rays to the ground plane.
    // Tangent ray from lightPos through terminator ring point → hits plane at t below.
    const GROUND_Y = -(SPHERE_RADIUS + 0.5);  // -2.0
    const shadowT  = (GROUND_Y - lightPos.y) / (planeDist - lightPos.y);
    const castShadowRadius = ringRadius * Math.abs(shadowT);

    const groundMesh = new THREE.Mesh(
      new THREE.PlaneGeometry(24, 24),
      new THREE.MeshBasicMaterial({ color: 0x222222, side: THREE.DoubleSide })
    );
    groundMesh.rotation.x = -Math.PI / 2;
    groundMesh.position.y = GROUND_Y;
    groundMesh.visible = false;
    scene.add(groundMesh);

    const castShadowMesh = new THREE.Mesh(
      new THREE.CircleGeometry(castShadowRadius, 64),
      new THREE.MeshBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.72, depthWrite: false })
    );
    castShadowMesh.rotation.x = -Math.PI / 2;
    castShadowMesh.position.y = GROUND_Y + 0.003;
    castShadowMesh.visible = false;
    scene.add(castShadowMesh);

    let groundVisible = false;
    function toggleGround() {
      groundVisible = !groundVisible;
      groundMesh.visible = groundVisible;
      // Re-sync cast shadow label — only visible when both labels and ground are on
      const castShow = labelsVisible && groundVisible;
      LABEL_DEFS[LABEL_DEFS.length - 1].el.classList.toggle('visible', castShow);
      labelLines[labelLines.length - 1].visible = castShow;
      const btn = document.getElementById('ground-btn')!;
      btn.textContent = groundVisible ? 'G — Hide ground' : 'G — Show ground';
      btn.classList.toggle('active', groundVisible);
    }

    // ── Ring trace animation ──────────────────────────────────────────────────
    const TRACE_STEPS = 36;  // one dot every 5°
    const TRACE_DELAY = 40;  // ms per step (~2.9 s total)
    let traceAnim: { step: number; timerId: number } | null = null;
    const traceBtn = document.getElementById('trace-btn')!;

    function traceStep() {
      if (!traceAnim) return;
      if (traceAnim.step >= TRACE_STEPS) { stopTrace(); return; }

      const a = START_ANGLE + (traceAnim.step / TRACE_STEPS) * Math.PI * 2;
      const p = ringCenter.clone()
        .addScaledVector(termU, Math.cos(a) * ringRadius)
        .addScaledVector(termV, Math.sin(a) * ringRadius);

      const { az, pol } = anglesFromDir(p.clone().sub(lightPos));
      azimuth = az; polar = pol;
      applyDir();
      placeDot(p);
      if (groundVisible) {
        raycaster.set(lightPos, p.clone().sub(lightPos).normalize());
        const gHits = raycaster.intersectObject(groundMesh);
        if (gHits.length > 0) placeDot(gHits[0].point.clone());
      }

      traceAnim.step++;
      traceAnim.timerId = window.setTimeout(traceStep, TRACE_DELAY);
    }

    function startTrace() {
      if (traceAnim) { stopTrace(); return; }
      traceAnim = { step: 0, timerId: 0 };
      traceBtn.textContent = 'T — Stop trace';
      traceBtn.classList.add('active');
      traceStep();
    }

    function stopTrace() {
      if (!traceAnim) return;
      window.clearTimeout(traceAnim.timerId);
      traceAnim = null;
      traceBtn.textContent = 'T — Trace terminator';
      traceBtn.classList.remove('active');
    }

    // ── Orbit (right-click only) ──────────────────────────────────────────────
    const controls = new OrbitControls(camera, canvas);
    controls.mouseButtons = { LEFT: null as any, MIDDLE: THREE.MOUSE.DOLLY, RIGHT: THREE.MOUSE.ROTATE };
    controls.target.set(0, 5, 0);
    controls.enableDamping = true;
    controls.update();

    // Start angle for ring trace: terminator point most toward the initial camera
    const _toCam     = camera.position.clone().sub(controls.target).normalize();
    const _lightN    = lightPos.clone().normalize();
    const _proj      = _toCam.addScaledVector(_lightN, -_toCam.dot(_lightN));
    const START_ANGLE = Math.atan2(_proj.dot(termV), _proj.dot(termU));

    // ── Zone labels ───────────────────────────────────────────────────────────
    let labelsVisible = false;

    const termAnchor = ringCenter.clone().addScaledVector(termU, ringRadius);
    const LABEL_DEFS = [
      { el: document.getElementById('lbl-light')!,  anchor: new THREE.Vector3(0, SPHERE_RADIUS, 0),                    pos: new THREE.Vector3(2.4,  2.2, 0),       color: 0xff8c42 },
      { el: document.getElementById('lbl-term')!,   anchor: termAnchor,                                                pos: new THREE.Vector3(2.9,  ringCenter.y, 0), color: 0xff8c42 },
      { el: document.getElementById('lbl-shadow')!, anchor: new THREE.Vector3(0, -SPHERE_RADIUS, 0),                   pos: new THREE.Vector3(2.4, -1.9, 0),       color: 0xff8c42 },
      { el: document.getElementById('lbl-cast')!,   anchor: new THREE.Vector3(-castShadowRadius, GROUND_Y + 0.003, 0), pos: new THREE.Vector3(-3.2, GROUND_Y + 0.4, 0), color: 0xff8c42 },
    ];

    const labelLineMats: LineMaterial[] = [];
    const labelLines = LABEL_DEFS.map(d => {
      const geo = new LineGeometry();
      geo.setPositions([d.anchor.x, d.anchor.y, d.anchor.z, d.pos.x, d.pos.y, d.pos.z]);
      const mat = new LineMaterial({ color: d.color, transparent: true, opacity: 0.5, linewidth: 2, resolution: new THREE.Vector2(window.innerWidth, window.innerHeight) });
      labelLineMats.push(mat);
      const line = new Line2(geo, mat);
      line.visible = false;
      scene.add(line);
      return line;
    });

    function toggleLabels() {
      labelsVisible = !labelsVisible;
      // Terminator
      termFadeTarget = labelsVisible ? 1 : 0;
      if (labelsVisible) termLine.visible = true;
      // Zone highlights + cast shadow
      lightZone.visible      = labelsVisible;
      shadowZone.visible     = labelsVisible;
      castShadowMesh.visible = labelsVisible;
      // Floating labels + connector lines
      LABEL_DEFS.forEach((d, i) => {
        const isCast = i === LABEL_DEFS.length - 1;
        const show   = labelsVisible && (!isCast || groundVisible);
        d.el.classList.toggle('visible', show);
        labelLines[i].visible = show;
      });
      const btn = document.getElementById('labels-btn')!;
      btn.textContent = labelsVisible ? 'L — Hide labels' : 'L — Show labels';
      btn.classList.toggle('active', labelsVisible);
    }

    // ── Resize ────────────────────────────────────────────────────────────────
    function setSize() {
      const w = window.innerWidth, h = window.innerHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      rayMat.resolution.set(w, h);
      termMat.resolution.set(w, h);
      labelLineMats.forEach(m => m.resolution.set(w, h));
    }
    setSize();
    window.addEventListener('resize', setSize);

    // ── View orientation sphere ───────────────────────────────────────────────
    const GIZMO = 110;
    const axesScene = new THREE.Scene();
    axesScene.add(new THREE.AmbientLight(0xffffff, 0.55));
    const gizmoLight = new THREE.DirectionalLight(0xffffff, 0.6);
    gizmoLight.position.set(0, 0, 3);
    axesScene.add(gizmoLight);

    // Bake face colors + labels into a canvas texture (1024×512 = 2:1 for sphere UV)
    const TEX_W = 1024, TEX_H = 512;
    const texCanvas = document.createElement('canvas');
    texCanvas.width = TEX_W; texCanvas.height = TEX_H;
    const texCtx = texCanvas.getContext('2d')!;
    const imgData = texCtx.createImageData(TEX_W, TEX_H);
    const buf = imgData.data;

    for (let row = 0; row < TEX_H; row++) {
      const theta = (row / TEX_H) * Math.PI;  // 0 = north pole, π = south pole
      const sinT  = Math.sin(theta);
      const y     = Math.cos(theta);
      for (let col = 0; col < TEX_W; col++) {
        const phi = (col / TEX_W) * Math.PI * 2;
        const x   = -Math.cos(phi) * sinT;
        const z   =  Math.sin(phi) * sinT;
        const ax  = Math.abs(x), ay = Math.abs(y), az = Math.abs(z);
        let r: number, g: number, b: number;
        if (ax >= ay && ax >= az)
          [r,g,b] = x > 0 ? [191,51,51] : [38,142,142];
        else if (ay >= ax && ay >= az)
          [r,g,b] = y > 0 ? [51,174,51] : [128,46,153];
        else
          [r,g,b] = z > 0 ? [56,85,191] : [140,46,46];
        const idx = (row * TEX_W + col) * 4;
        buf[idx] = r; buf[idx+1] = g; buf[idx+2] = b; buf[idx+3] = 255;
      }
    }
    texCtx.putImageData(imgData, 0, 0);

    texCtx.textAlign = 'center';
    texCtx.textBaseline = 'middle';
    texCtx.fillStyle = 'white';
    texCtx.shadowColor = 'rgba(0,0,0,0.7)';
    texCtx.shadowBlur = 10;
    texCtx.font = 'bold 58px sans-serif';
    // Equatorial faces only — Top/Bottom handled by flat cap discs below
    [
      ['Front',  0.25 * TEX_W, 0.50 * TEX_H],
      ['Right',  0.50 * TEX_W, 0.50 * TEX_H],
      ['Back',   0.75 * TEX_W, 0.50 * TEX_H],
    ].forEach(([t, lx, ly]) => texCtx.fillText(t as string, lx as number, ly as number));
    // Left face straddles the seam at u=0/1 — draw at both edges so it wraps
    texCtx.fillText('Left', 0,      0.50 * TEX_H);
    texCtx.fillText('Left', TEX_W,  0.50 * TEX_H);

    const gizmoTexture = new THREE.CanvasTexture(texCanvas);
    const gizmoSphere = new THREE.Mesh(
      new THREE.SphereGeometry(0.8, 64, 64),
      new THREE.MeshLambertMaterial({ map: gizmoTexture })
    );
    axesScene.add(gizmoSphere);

    // Flat cap discs for Top/Bottom — no UV distortion
    function makeCapDisc(label: string, yPos: number, flipY: boolean) {
      const S = 256;
      const cc = document.createElement('canvas');
      cc.width = S; cc.height = S;
      const cx = cc.getContext('2d')!;
      cx.textAlign = 'center';
      cx.textBaseline = 'middle';
      cx.fillStyle = 'white';
      cx.shadowColor = 'rgba(0,0,0,0.6)';
      cx.shadowBlur = 8;
      cx.font = 'bold 64px sans-serif';
      cx.fillText(label, S / 2, S / 2);
      const disc = new THREE.Mesh(
        new THREE.CircleGeometry(0.42, 48),
        new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(cc), transparent: true, depthWrite: false })
      );
      disc.position.y = yPos;
      disc.rotation.x = flipY ? Math.PI / 2 : -Math.PI / 2;
      return disc;
    }
    const topCap    = makeCapDisc('Top',    0.802,  false);
    const bottomCap = makeCapDisc('Bottom', -0.802, true);
    gizmoSphere.add(topCap);
    gizmoSphere.add(bottomCap);

    const axesCamera = new THREE.PerspectiveCamera(50, 1, 0.1, 10);
    axesCamera.position.set(0, 0, 3);

    let snapAnim: {
      from: THREE.Vector3; to: THREE.Vector3;
      fromUp: THREE.Vector3; toUp: THREE.Vector3;
      start: number;
    } | null = null;

    function snapToView(face: string) {
      const dist = camera.position.distanceTo(controls.target);
      const t = controls.target;
      const up0 = new THREE.Vector3(0, 1, 0);
      const snaps: Record<string, { pos: THREE.Vector3; up: THREE.Vector3 }> = {
        front:  { pos: new THREE.Vector3(t.x,        t.y,        t.z + dist), up: up0.clone() },
        back:   { pos: new THREE.Vector3(t.x,        t.y,        t.z - dist), up: up0.clone() },
        right:  { pos: new THREE.Vector3(t.x + dist, t.y,        t.z       ), up: up0.clone() },
        left:   { pos: new THREE.Vector3(t.x - dist, t.y,        t.z       ), up: up0.clone() },
        top:    { pos: new THREE.Vector3(t.x,        t.y + dist, t.z       ), up: new THREE.Vector3(0, 0, -1) },
        bottom: { pos: new THREE.Vector3(t.x,        t.y - dist, t.z       ), up: new THREE.Vector3(0, 0,  1) },
      };
      const s = snaps[face];
      if (!s) return;
      snapAnim = {
        from: camera.position.clone(), to: s.pos,
        fromUp: camera.up.clone(), toUp: s.up,
        start: performance.now(),
      };
      controls.enabled = false;
    }

    // ── UI wiring ─────────────────────────────────────────────────────────────
    const sprayValInput  = document.getElementById('spray-val')!    as HTMLInputElement;
    const spraySlider    = document.getElementById('spray-slider')! as HTMLInputElement;
    const spreadValInput = document.getElementById('spread-val')!   as HTMLInputElement;
    const spreadSlider   = document.getElementById('spread-slider')! as HTMLInputElement;

    function adjustCount(delta: number) {
      sprayCount = Math.max(1, Math.min(1000, sprayCount + delta));
      sprayValInput.value = String(sprayCount);
      spraySlider.value   = String(Math.min(sprayCount, 100));
    }
    function adjustSpread(delta: number) {
      const deg = Math.max(1, Math.min(90, Math.round(spraySpread * 180 / Math.PI) + delta));
      spraySpread = deg * Math.PI / 180;
      spreadValInput.value = String(deg);
      spreadSlider.value   = String(deg);
    }

    sprayValInput.addEventListener('input', () => {
      sprayCount = Math.max(1, parseInt(sprayValInput.value) || 1);
      spraySlider.value = String(Math.min(sprayCount, 100));
    });
    spraySlider.addEventListener('input', () => {
      sprayCount = parseInt(spraySlider.value);
      sprayValInput.value = String(sprayCount);
    });
    spreadValInput.addEventListener('input', () => {
      const deg = Math.max(1, Math.min(90, parseInt(spreadValInput.value) || 1));
      spraySpread = deg * Math.PI / 180;
      spreadSlider.value = String(deg);
    });
    spreadSlider.addEventListener('input', () => {
      const deg = parseInt(spreadSlider.value);
      spraySpread = deg * Math.PI / 180;
      spreadValInput.value = String(deg);
    });
    const panel       = document.getElementById('panel')!;
    const panelToggle = document.getElementById('panel-toggle')!;
    function togglePanel() {
      const collapsed = panel.classList.toggle('collapsed');
      panelToggle.textContent = collapsed ? '▴' : '▾';
    }
    panel.querySelector('h3')!.addEventListener('click', togglePanel);

    traceBtn.addEventListener('click', startTrace);
    document.getElementById('labels-btn')!.addEventListener('click', toggleLabels);
    document.getElementById('ground-btn')!.addEventListener('click', toggleGround);
    document.getElementById('clear-btn')!.addEventListener('click', clearDots);

    // ── Render loop ───────────────────────────────────────────────────────────
    function animate() {
      requestAnimationFrame(animate);

      // Snap animation
      if (snapAnim) {
        const t = Math.min((performance.now() - snapAnim.start) / 300, 1);
        const ease = 1 - Math.pow(1 - t, 3);
        camera.position.lerpVectors(snapAnim.from, snapAnim.to, ease);
        camera.up.lerpVectors(snapAnim.fromUp, snapAnim.toUp, ease).normalize();
        camera.lookAt(controls.target);
        if (t >= 1) {
          controls.update();
          controls.enabled = true;
          snapAnim = null;
        }
      }

      controls.update();

      // Terminator fade
      const termDiff = termFadeTarget - termMat.opacity;
      if (Math.abs(termDiff) > 0.001) {
        termMat.opacity = THREE.MathUtils.clamp(termMat.opacity + Math.sign(termDiff) * 0.07, 0, 1);
        if (termMat.opacity <= 0) termLine.visible = false;
      }

      renderer.setScissorTest(false);
      renderer.setViewport(0, 0, window.innerWidth, window.innerHeight);
      renderer.render(scene, camera);

      // Project zone label divs to screen space
      if (labelsVisible) {
        LABEL_DEFS.forEach(d => {
          const proj = d.pos.clone().project(camera);
          d.el.style.left = ((proj.x  + 1) / 2 * window.innerWidth)  + 'px';
          d.el.style.top  = ((-proj.y + 1) / 2 * window.innerHeight) + 'px';
        });
      }

      // View sphere (top-right) — sphere rotates, camera stays fixed
      gizmoSphere.quaternion.copy(camera.quaternion).invert();

      renderer.setScissorTest(true);
      renderer.setScissor(window.innerWidth - GIZMO, window.innerHeight - GIZMO, GIZMO, GIZMO);
      renderer.setViewport(window.innerWidth - GIZMO, window.innerHeight - GIZMO, GIZMO, GIZMO);
      renderer.render(axesScene, axesCamera);
      renderer.setScissorTest(false);
    }
    animate();
  </script>
</body>
</html>
