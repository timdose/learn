---
import BaseLayout from '../../layouts/BaseLayout.astro';

const demos: Array<{ title: string; href: string; description: string }> = [
  { title: 'Light Zones', href: '/demos/light-zones/', description: 'How a point light illuminates one hemisphere of a sphere' },
  { title: 'Highlights', href: '/demos/highlights/', description: 'How surface roughness and viewing angle affect specular highlights' },
  { title: 'Form Direction', href: '/demos/form-direction/', description: 'Work in progress' },
];
---
<BaseLayout title="Demos">
  <article class="post">
    <h1>Demos</h1>
    <p>Interactive diagrams illustrating concepts in art and drawing.</p>
    {demos.length === 0 ? (
      <p><em>Coming soon.</em></p>
    ) : (
      <ul>
        {demos.map(d => (
          <li><a href={d.href}>{d.title}</a> — {d.description}</li>
        ))}
      </ul>
    )}
  </article>
</BaseLayout>
