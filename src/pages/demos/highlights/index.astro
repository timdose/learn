---
import DemoLayout from '../../../layouts/DemoLayout.astro';
---
<DemoLayout title="Highlights">

  <div slot="labels" id="pin-labels">
    <div class="pin-label" id="lbl-pin-light"></div>
    <div class="pin-label" id="lbl-pin-highlight"></div>
    <div class="pin-label" id="lbl-pin-camera"></div>
  </div>

  <Fragment slot="panel">
    <div class="row">
      <label>Roughness</label>
      <span class="val" id="roughness-val">0.20</span>
    </div>
    <input type="range" class="val-slider" id="roughness-slider" min="0" max="1" step="0.01" value="0.2">
    <label class="toggle-row" for="highlight-chk">
      <span>Highlight</span>
      <span class="toggle">
        <input type="checkbox" id="highlight-chk" checked>
        <span class="toggle-track"></span>
      </span>
    </label>
    <label class="toggle-row" for="arcs-chk">
      <span>Arcs</span>
      <span class="toggle">
        <input type="checkbox" id="arcs-chk">
        <span class="toggle-track"></span>
      </span>
    </label>
    <button class="pin-btn" id="pin-light-btn">Facing light</button>
    <button class="pin-btn" id="pin-highlight-btn">At highlight</button>
    <button class="pin-btn" id="pin-camera-btn">Facing viewer</button>
    <button id="pin-clear-btn">Clear pins</button>
  </Fragment>

  <Fragment slot="help">
    <div class="help-row"><span class="help-keys"><kbd>H</kbd></span><span class="help-desc">Toggle highlight</span></div>
    <div class="help-row"><span class="help-keys"><kbd>A</kbd></span><span class="help-desc">Toggle arcs</span></div>
    <div class="help-row"><span class="help-keys"><kbd>[</kbd> <kbd>]</kbd></span><span class="help-desc">Roughness ±0.1</span></div>
    <div class="help-row"><span class="help-keys"><kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd></span><span class="help-desc">Pin light / highlight / camera</span></div>
    <div class="help-row"><span class="help-keys"><kbd>C</kbd></span><span class="help-desc">Clear pins</span></div>
    <div class="help-row"><span class="help-keys"><kbd>L</kbd> <kbd>F</kbd> <kbd>R</kbd> <kbd>T</kbd></span><span class="help-desc">Snap left / front / right / top</span></div>
  </Fragment>

  <style is:global>
    #pin-labels { position: fixed; inset: 0; pointer-events: none; }
    .pin-label {
      position: absolute; transform: translate(-100%, -100%);
      font: 11px/1 sans-serif; letter-spacing: 0.06em; text-transform: uppercase;
      white-space: nowrap; background: rgba(0,0,0,0.85); padding: 2px 7px; border-radius: 3px;
      opacity: 0; transition: opacity 0.3s;
    }
    .pin-label.visible { opacity: 1; }
    #pin-clear-btn { color: #888; }
  </style>

  <script>
    import * as THREE from 'three';
    import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

    // ── Colours — edit here to restyle the demo ────────────────────────────────
    const COLOR = {
      bg:           0x000000,
      sphere:       0x888888,
      lightMarker:  0xffffff,
      pinLight:     0xffcc44,
      pinHighlight: 0xffffff,
      pinCamera:    0x4444ff,
      arc:          0xaa0000,
      gizmoRight:   0xbf3333,
      gizmoLeft:    0x268e8e,
      gizmoTop:     0x33ae33,
      gizmoBottom:  0x802e99,
      gizmoFront:   0x3855bf,
      gizmoBack:    0x8c2e2e,
    };
    const toRGB = (c: number): [number, number, number] =>
      [(c >> 16) & 0xff, (c >> 8) & 0xff, c & 0xff];
    const toHex = (c: number) => `#${c.toString(16).padStart(6, '0')}`;

    // ── Renderer ───────────────────────────────────────────────────────────────
    const canvas = document.getElementById('demo-canvas') as HTMLCanvasElement;
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1;
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(COLOR.bg);

    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 200);
    camera.position.set(0, 4, 22);

    // ── Lights ─────────────────────────────────────────────────────────────────
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.2);
    scene.add(ambientLight);

    const LIGHT_DIST = 8;
    let lightAngle = Math.PI / 2; // starts directly above sphere
    const lightPos = new THREE.Vector3();

    const pointLight = new THREE.PointLight(0xffffff, 200, 0, 2);
    scene.add(pointLight);

    const lightMarker = new THREE.Mesh(
      new THREE.SphereGeometry(0.22, 16, 16),
      new THREE.MeshStandardMaterial({ emissive: COLOR.lightMarker, emissiveIntensity: 1, color: COLOR.bg })
    );
    scene.add(lightMarker);

    function setLightFromAngle() {
      lightPos.set(0, LIGHT_DIST * Math.sin(lightAngle), LIGHT_DIST * Math.cos(lightAngle));
      pointLight.position.copy(lightPos);
      lightMarker.position.copy(lightPos);
    }
    setLightFromAngle();

    // ── Sphere ─────────────────────────────────────────────────────────────────
    const SPHERE_R = 1.5;
    const sphereMat = new THREE.MeshStandardMaterial({
      color:     COLOR.sphere,
      roughness: 0.2,
      metalness: 0.0,
    });
    const sphere = new THREE.Mesh(new THREE.SphereGeometry(SPHERE_R, 128, 128), sphereMat);
    scene.add(sphere);

    // ── Pins ───────────────────────────────────────────────────────────────────
    const PIN_COLORS     = { light: COLOR.pinLight, highlight: COLOR.pinHighlight, camera: COLOR.pinCamera };
    type PinType = keyof typeof PIN_COLORS;
    const PIN_LABEL_TEXT: Record<PinType, string> = { light: 'Facing Light', highlight: 'Highlight', camera: 'Facing viewer' };
    const PIN_LEN         = 0.6;
    const PIN_SHAFT_R     = 0.02;
    const PIN_TIP_R       = 0.1;
    const PIN_CONE_H      = 0.22;
    const PIN_ANIM_MS     = 250;
    const PIN_ANIM_OFFSET = 0.4;
    const pins: Partial<Record<PinType, THREE.Group>> = {};
    const pinNormals: Partial<Record<PinType, THREE.Vector3>> = {};
    const pinLabelAnchors: Partial<Record<PinType, THREE.Vector3>> = {};
    const pinLabelEls = {
      light:     document.getElementById('lbl-pin-light')!,
      highlight: document.getElementById('lbl-pin-highlight')!,
      camera:    document.getElementById('lbl-pin-camera')!,
    } as Record<PinType, HTMLElement>;
    (Object.keys(PIN_LABEL_TEXT) as PinType[]).forEach(t => {
      pinLabelEls[t].textContent = PIN_LABEL_TEXT[t];
      pinLabelEls[t].style.color = toHex(PIN_COLORS[t]);
    });
    type PinAnim = { pin: THREE.Group; startPos: THREE.Vector3; mats: THREE.MeshBasicMaterial[]; start: number };
    const pinAnims: PinAnim[] = [];
    const _pL = new THREE.Vector3();
    const _pV = new THREE.Vector3();
    const _pH = new THREE.Vector3();

    // ── Arc helpers ────────────────────────────────────────────────────────────
    function slerpVec(a: THREE.Vector3, b: THREE.Vector3, t: number): THREE.Vector3 {
      const dot = Math.max(-1, Math.min(1, a.dot(b)));
      const angle = Math.acos(dot);
      if (angle < 0.0001) return a.clone().lerp(b, t).normalize();
      const s = Math.sin(angle);
      return a.clone().multiplyScalar(Math.sin((1-t)*angle)/s)
             .addScaledVector(b, Math.sin(t*angle)/s);
    }

    const ARC_SURFACE_OFFSET = 0.3;
    const ARC_TUBE_R         = 0.02;
    const ARC_TICK_LEN       = 0.20;
    const ARC_TICK_R         = 0.02;
    const ARC_OPACITY        = 0.65;
    const ARC_DRAW_MS        = 300;
    const ARC_PAUSE_MS       = 300;
    const ARC_FADE_MS        = 300;
    let arcsVisible = false;
    type ArcEntry = { group: THREE.Group; tubeGeo: THREE.TubeGeometry; tickMat: THREE.MeshBasicMaterial; maxIdx: number };
    type ArcAnim  = { start: number; both: boolean };
    const arcEntries: Partial<Record<'cameraToHighlight'|'highlightToLight', ArcEntry>> = {};
    let arcAnim: ArcAnim | null = null;

    function makeArcEntry(dirA: THREE.Vector3, dirB: THREE.Vector3): ArcEntry {
      const tubeMat = new THREE.MeshBasicMaterial({ color: COLOR.arc, transparent: true, opacity: ARC_OPACITY });
      const tickMat = new THREE.MeshBasicMaterial({ color: COLOR.arc, transparent: true, opacity: 0 });
      const pts: THREE.Vector3[] = [];
      for (let i = 0; i <= 48; i++) pts.push(slerpVec(dirA, dirB, i / 48).multiplyScalar(SPHERE_R + ARC_SURFACE_OFFSET));
      const tubeGeo = new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts), 48, ARC_TUBE_R, 6, false);
      tubeGeo.setDrawRange(0, 0);
      const tube = new THREE.Mesh(tubeGeo, tubeMat);
      const midDir = slerpVec(dirA, dirB, 0.5).normalize();
      const tick = new THREE.Mesh(
        new THREE.CylinderGeometry(ARC_TICK_R, ARC_TICK_R, ARC_TICK_LEN, 6),
        tickMat
      );
      tick.position.copy(midDir).multiplyScalar(SPHERE_R + ARC_SURFACE_OFFSET);
      tick.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), midDir);
      const group = new THREE.Group();
      group.add(tube, tick);
      return { group, tubeGeo, tickMat, maxIdx: tubeGeo.index!.count };
    }

    function updateArcs() {
      (['cameraToHighlight', 'highlightToLight'] as const).forEach(k => {
        if (arcEntries[k]) { scene.remove(arcEntries[k]!.group); delete arcEntries[k]; }
      });
      arcAnim = null;
      if (!arcsVisible) return;
      const hasC2H = !!(pinNormals.camera && pinNormals.highlight);
      const hasH2L = !!(pinNormals.highlight && pinNormals.light);
      if (hasC2H) {
        arcEntries.cameraToHighlight = makeArcEntry(pinNormals.camera!, pinNormals.highlight!);
        scene.add(arcEntries.cameraToHighlight.group);
      }
      if (hasH2L) {
        arcEntries.highlightToLight = makeArcEntry(pinNormals.highlight!, pinNormals.light!);
        scene.add(arcEntries.highlightToLight.group);
      }
      if (hasC2H || hasH2L) arcAnim = { start: performance.now(), both: hasC2H && hasH2L };
    }

    function setArcsVisible(v: boolean) {
      arcsVisible = v;
      updateArcs();
    }

    function placePin(type: PinType) {
      if (pins[type]) {
        const old = pins[type]!;
        scene.remove(old);
        const idx = pinAnims.findIndex(a => a.pin === old);
        if (idx !== -1) pinAnims.splice(idx, 1);
      }
      _pL.copy(lightPos).normalize();
      _pV.copy(camera.position).normalize();
      _pH.addVectors(_pL, _pV).normalize();
      const normal = type === 'light' ? _pL.clone() : type === 'highlight' ? _pH.clone() : _pV.clone();
      pinNormals[type] = normal;
      const color  = PIN_COLORS[type];
      const shaftMat = new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0 });
      const tipMat   = new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0 });
      const shaft = new THREE.Mesh(new THREE.CylinderGeometry(PIN_SHAFT_R, PIN_SHAFT_R, PIN_LEN, 8), shaftMat);
      shaft.position.copy(normal).multiplyScalar(SPHERE_R + 0.002 + PIN_LEN / 2);
      shaft.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), normal);
      let tipMesh: THREE.Mesh;
      if (type === 'highlight') {
        tipMesh = new THREE.Mesh(new THREE.SphereGeometry(PIN_TIP_R, 12, 12), tipMat);
        tipMesh.position.copy(normal).multiplyScalar(SPHERE_R + 0.002 + PIN_LEN);
      } else {
        tipMesh = new THREE.Mesh(new THREE.ConeGeometry(PIN_TIP_R, PIN_CONE_H, 8), tipMat);
        tipMesh.position.copy(normal).multiplyScalar(SPHERE_R + 0.002 + PIN_LEN + PIN_CONE_H / 2);
        tipMesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), normal);
      }
      const tipExtent = type === 'highlight' ? PIN_TIP_R : PIN_CONE_H;
      pinLabelAnchors[type] = normal.clone().multiplyScalar(SPHERE_R + 0.002 + PIN_LEN + tipExtent + 0.15);
      const pin = new THREE.Group();
      pin.add(shaft, tipMesh);
      const startPos = normal.clone().multiplyScalar(PIN_ANIM_OFFSET);
      pin.position.copy(startPos);
      scene.add(pin);
      pins[type] = pin;
      pinAnims.push({ pin, startPos, mats: [shaftMat, tipMat], start: performance.now() });
      pinLabelEls[type].classList.add('visible');
      updateArcs();
    }

    function clearPins() {
      (Object.keys(pins) as PinType[]).forEach(k => {
        scene.remove(pins[k]!);
        delete pins[k];
        delete pinNormals[k];
        delete pinLabelAnchors[k];
        pinLabelEls[k].classList.remove('visible');
      });
      pinAnims.length = 0;
      updateArcs();
    }

    // ── Controls ───────────────────────────────────────────────────────────────
    const controls = new OrbitControls(camera, canvas);
    controls.target.set(0, 4, 0);
    controls.enableDamping = true;
    controls.update();

    // ── Gizmo ──────────────────────────────────────────────────────────────────
    const GIZMO = 110;
    let gizmoDragActive = false;
    let gizmoDragMoved  = false;
    let gizmoDragLastX  = 0;
    let gizmoDragLastY  = 0;

    const axesScene = new THREE.Scene();
    axesScene.add(new THREE.AmbientLight(0xffffff, 0.55));
    const gizmoLight = new THREE.DirectionalLight(0xffffff, 0.6);
    gizmoLight.position.set(0, 0, 3);
    axesScene.add(gizmoLight);

    const TEX_W = 1024, TEX_H = 512;
    const texCanvas = document.createElement('canvas');
    texCanvas.width = TEX_W; texCanvas.height = TEX_H;
    const texCtx = texCanvas.getContext('2d')!;
    const imgData = texCtx.createImageData(TEX_W, TEX_H);
    const buf = imgData.data;
    for (let row = 0; row < TEX_H; row++) {
      const theta = (row / TEX_H) * Math.PI;
      const sinT  = Math.sin(theta);
      const y     = Math.cos(theta);
      for (let col = 0; col < TEX_W; col++) {
        const phi = (col / TEX_W) * Math.PI * 2;
        const x   = -Math.cos(phi) * sinT;
        const z   =  Math.sin(phi) * sinT;
        const ax  = Math.abs(x), ay = Math.abs(y), az = Math.abs(z);
        let r: number, g: number, b: number;
        if (ax >= ay && ax >= az)      [r,g,b] = x > 0 ? toRGB(COLOR.gizmoRight) : toRGB(COLOR.gizmoLeft);
        else if (ay >= ax && ay >= az) [r,g,b] = y > 0 ? toRGB(COLOR.gizmoTop)   : toRGB(COLOR.gizmoBottom);
        else                           [r,g,b] = z > 0 ? toRGB(COLOR.gizmoFront) : toRGB(COLOR.gizmoBack);
        const idx = (row * TEX_W + col) * 4;
        buf[idx] = r; buf[idx+1] = g; buf[idx+2] = b; buf[idx+3] = 255;
      }
    }
    texCtx.putImageData(imgData, 0, 0);
    texCtx.textAlign = 'center'; texCtx.textBaseline = 'middle';
    texCtx.fillStyle = 'white'; texCtx.shadowColor = 'rgba(0,0,0,0.7)'; texCtx.shadowBlur = 10;
    texCtx.font = 'bold 58px sans-serif';
    [['Front', 0.25*TEX_W, 0.50*TEX_H], ['Right', 0.50*TEX_W, 0.50*TEX_H], ['Back', 0.75*TEX_W, 0.50*TEX_H]]
      .forEach(([t,lx,ly]) => texCtx.fillText(t as string, lx as number, ly as number));
    texCtx.fillText('Left', 0, 0.50*TEX_H);
    texCtx.fillText('Left', TEX_W, 0.50*TEX_H);

    const gizmoSphere = new THREE.Mesh(
      new THREE.SphereGeometry(0.8, 64, 64),
      new THREE.MeshLambertMaterial({ map: new THREE.CanvasTexture(texCanvas) })
    );
    axesScene.add(gizmoSphere);

    function makeCapDisc(label: string, yPos: number, flipY: boolean) {
      const S = 256;
      const cc = document.createElement('canvas');
      cc.width = S; cc.height = S;
      const cx = cc.getContext('2d')!;
      cx.textAlign = 'center'; cx.textBaseline = 'middle';
      cx.fillStyle = 'white'; cx.shadowColor = 'rgba(0,0,0,0.6)'; cx.shadowBlur = 8;
      cx.font = 'bold 64px sans-serif';
      cx.fillText(label, S/2, S/2);
      const disc = new THREE.Mesh(
        new THREE.CircleGeometry(0.42, 48),
        new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(cc), transparent: true, depthWrite: false })
      );
      disc.position.y = yPos;
      disc.rotation.x = flipY ? Math.PI/2 : -Math.PI/2;
      return disc;
    }
    const topCap    = makeCapDisc('Top',    0.802,  false);
    const bottomCap = makeCapDisc('Bottom', -0.802, true);
    gizmoSphere.add(topCap, bottomCap);

    const axesCamera = new THREE.PerspectiveCamera(50, 1, 0.1, 10);
    axesCamera.position.set(0, 0, 3);

    let snapAnim: { from: THREE.Vector3; to: THREE.Vector3; fromUp: THREE.Vector3; toUp: THREE.Vector3; start: number } | null = null;

    function snapToView(face: string) {
      const dist = camera.position.distanceTo(controls.target);
      const t = controls.target;
      const up0 = new THREE.Vector3(0, 1, 0);
      const snaps: Record<string, { pos: THREE.Vector3; up: THREE.Vector3 }> = {
        front:  { pos: new THREE.Vector3(t.x,        t.y,        t.z + dist), up: up0.clone() },
        back:   { pos: new THREE.Vector3(t.x,        t.y,        t.z - dist), up: up0.clone() },
        right:  { pos: new THREE.Vector3(t.x + dist, t.y,        t.z       ), up: up0.clone() },
        left:   { pos: new THREE.Vector3(t.x - dist, t.y,        t.z       ), up: up0.clone() },
        top:    { pos: new THREE.Vector3(t.x,        t.y + dist, t.z       ), up: new THREE.Vector3(0, 0, -1) },
        bottom: { pos: new THREE.Vector3(t.x,        t.y - dist, t.z       ), up: new THREE.Vector3(0, 0,  1) },
      };
      const s = snaps[face];
      if (!s) return;
      snapAnim = { from: camera.position.clone(), to: s.pos, fromUp: camera.up.clone(), toUp: s.up, start: performance.now() };
      controls.enabled = false;
    }

    // ── Light drag ─────────────────────────────────────────────────────────────
    const raycaster = new THREE.Raycaster();
    const _ndc = new THREE.Vector2();
    let draggingLight = false;
    let prevDragX = 0, prevDragY = 0;
    const LIGHT_DRAG_SPEED = 0.012;

    function toNDC(clientX: number, clientY: number) {
      _ndc.set((clientX / window.innerWidth) * 2 - 1, -(clientY / window.innerHeight) * 2 + 1);
    }

    canvas.addEventListener('pointerdown', e => {
      if (e.clientX >= window.innerWidth - GIZMO && e.clientY < GIZMO) {
        gizmoDragActive = true;
        gizmoDragMoved  = false;
        gizmoDragLastX  = e.clientX;
        gizmoDragLastY  = e.clientY;
        canvas.setPointerCapture(e.pointerId);
        return;
      }
      toNDC(e.clientX, e.clientY);
      raycaster.setFromCamera(_ndc, camera);
      if (raycaster.intersectObject(lightMarker).length > 0) {
        draggingLight = true;
        prevDragX = e.clientX;
        prevDragY = e.clientY;
        controls.enabled = false;
        canvas.setPointerCapture(e.pointerId);
        canvas.style.cursor = 'grabbing';
      }
    });

    canvas.addEventListener('pointermove', e => {
      if (gizmoDragActive) {
        const dx = e.clientX - gizmoDragLastX;
        const dy = e.clientY - gizmoDragLastY;
        if (dx !== 0 || dy !== 0) gizmoDragMoved = true;
        gizmoDragLastX = e.clientX;
        gizmoDragLastY = e.clientY;
        const offset = camera.position.clone().sub(controls.target);
        const r = offset.length();
        let theta = Math.atan2(offset.x, offset.z);
        let phi   = Math.acos(THREE.MathUtils.clamp(offset.y / r, -1, 1));
        theta -= dx * 0.008;
        phi    = THREE.MathUtils.clamp(phi - dy * 0.008, 0.02, Math.PI - 0.02);
        offset.set(r * Math.sin(phi) * Math.sin(theta), r * Math.cos(phi), r * Math.sin(phi) * Math.cos(theta));
        camera.position.copy(controls.target).add(offset);
        camera.lookAt(controls.target);
        controls.update();
        return;
      }
      if (draggingLight) {
        const dx = e.clientX - prevDragX;
        const dy = e.clientY - prevDragY;
        prevDragX = e.clientX;
        prevDragY = e.clientY;
        const T      = new THREE.Vector3(0, Math.cos(lightAngle), -Math.sin(lightAngle));
        const fwd    = camera.getWorldDirection(new THREE.Vector3());
        const right  = new THREE.Vector3().crossVectors(fwd, camera.up).normalize();
        const rDotT  = right.dot(T);
        const uDotT  = camera.up.dot(T);
        const visLen = Math.sqrt(rDotT * rDotT + uDotT * uDotT);
        const blend  = THREE.MathUtils.smoothstep(visLen, 0.1, 0.35);
        lightAngle  += THREE.MathUtils.lerp(-dy, dx * rDotT - dy * uDotT, blend) * LIGHT_DRAG_SPEED;
        setLightFromAngle();
        return;
      }
      toNDC(e.clientX, e.clientY);
      raycaster.setFromCamera(_ndc, camera);
      canvas.style.cursor = raycaster.intersectObject(lightMarker).length > 0 ? 'grab' : '';
    });

    canvas.addEventListener('pointerup', e => {
      if (gizmoDragActive) {
        gizmoDragActive = false;
        canvas.releasePointerCapture(e.pointerId);
        return;
      }
      if (draggingLight) {
        draggingLight = false;
        controls.enabled = true;
        canvas.releasePointerCapture(e.pointerId);
        canvas.style.cursor = '';
      }
    });

    canvas.addEventListener('click', e => {
      if (!(e.clientX >= window.innerWidth - GIZMO && e.clientY < GIZMO)) return;
      if (gizmoDragMoved) { gizmoDragMoved = false; return; }
      const localX = e.clientX - (window.innerWidth - GIZMO);
      const ndcX   = (localX / GIZMO) * 2 - 1;
      const ndcY   = -((e.clientY / GIZMO) * 2 - 1);
      const gizmoPick = new THREE.Raycaster();
      gizmoPick.setFromCamera(new THREE.Vector2(ndcX, ndcY), axesCamera);
      const hits = gizmoPick.intersectObject(gizmoSphere, true);
      if (hits.length === 0) return;
      let face: string;
      if      (hits[0].object === topCap)    { face = 'top'; }
      else if (hits[0].object === bottomCap) { face = 'bottom'; }
      else if (hits[0].face) {
        const n = hits[0].face.normal;
        const ax = Math.abs(n.x), ay = Math.abs(n.y), az = Math.abs(n.z);
        if      (ax >= ay && ax >= az) face = n.x > 0 ? 'right' : 'left';
        else if (ay >= ax && ay >= az) face = n.y > 0 ? 'top'   : 'bottom';
        else                           face = n.z > 0 ? 'front' : 'back';
      } else { return; }
      snapToView(face);
    });

    // ── Panel wiring ───────────────────────────────────────────────────────────
    const roughnessSlider = document.getElementById('roughness-slider') as HTMLInputElement;
    const roughnessVal    = document.getElementById('roughness-val')!;
    roughnessSlider.addEventListener('input', () => {
      sphereMat.roughness = parseFloat(roughnessSlider.value);
      roughnessVal.textContent = parseFloat(roughnessSlider.value).toFixed(2);
    });

    const pinLightBtn = document.getElementById('pin-light-btn')!    as HTMLButtonElement;
    const pinHalfBtn  = document.getElementById('pin-highlight-btn')! as HTMLButtonElement;
    const pinCamBtn   = document.getElementById('pin-camera-btn')!   as HTMLButtonElement;
    pinLightBtn.style.color = toHex(COLOR.pinLight);
    pinHalfBtn.style.color  = toHex(COLOR.pinHighlight);
    pinCamBtn.style.color   = toHex(COLOR.pinCamera);
    pinLightBtn.addEventListener('click', () => placePin('light'));
    pinHalfBtn.addEventListener('click',  () => placePin('highlight'));
    pinCamBtn.addEventListener('click',   () => placePin('camera'));
    document.getElementById('pin-clear-btn')!.addEventListener('click', clearPins);

    const arcsChk = document.getElementById('arcs-chk') as HTMLInputElement;
    arcsChk.addEventListener('change', () => setArcsVisible(arcsChk.checked));

    const highlightChk = document.getElementById('highlight-chk') as HTMLInputElement;
    let savedRoughness = sphereMat.roughness;
    highlightChk.addEventListener('change', () => {
      if (highlightChk.checked) {
        sphereMat.roughness = savedRoughness;
        roughnessSlider.disabled = false;
        roughnessVal.textContent = savedRoughness.toFixed(2);
      } else {
        savedRoughness = sphereMat.roughness;
        sphereMat.roughness = 1.0;
        roughnessSlider.disabled = true;
      }
    });

    function adjustRoughness(delta: number) {
      if (roughnessSlider.disabled) return;
      const val = Math.max(0, Math.min(1, Math.round((sphereMat.roughness + delta) * 100) / 100));
      sphereMat.roughness = val;
      roughnessSlider.value = String(val);
      roughnessVal.textContent = val.toFixed(2);
    }

    window.addEventListener('keydown', e => {
      switch (e.key) {
        case 'h': case 'H':
          highlightChk.checked = !highlightChk.checked;
          highlightChk.dispatchEvent(new Event('change'));
          break;
        case 'a': case 'A':
          arcsChk.checked = !arcsChk.checked;
          setArcsVisible(arcsChk.checked);
          break;
        case '[': adjustRoughness(-0.1); break;
        case ']': adjustRoughness( 0.1); break;
        case '1': placePin('light');     break;
        case '2': placePin('highlight'); break;
        case '3': placePin('camera');    break;
        case 'c': clearPins();            break;
        case 'l': case 'L': snapToView('left');  break;
        case 'f': case 'F': snapToView('front'); break;
        case 'r': case 'R': snapToView('right'); break;
        case 't': case 'T': snapToView('top');   break;
      }
    });

    // ── Resize ─────────────────────────────────────────────────────────────────
    function setSize() {
      const w = window.innerWidth, h = window.innerHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    setSize();
    window.addEventListener('resize', setSize);

    // ── Render loop ────────────────────────────────────────────────────────────
    function animate() {
      requestAnimationFrame(animate);

      if (snapAnim) {
        const t    = Math.min((performance.now() - snapAnim.start) / 300, 1);
        const ease = 1 - Math.pow(1 - t, 3);
        const dist    = snapAnim.from.distanceTo(controls.target);
        const fromDir = snapAnim.from.clone().sub(controls.target).normalize();
        const toDir   = snapAnim.to.clone().sub(controls.target).normalize();
        camera.position.copy(controls.target).addScaledVector(fromDir.lerp(toDir, ease).normalize(), dist);
        camera.up.lerpVectors(snapAnim.fromUp, snapAnim.toUp, ease).normalize();
        camera.lookAt(controls.target);
        if (t >= 1) { controls.update(); controls.enabled = true; snapAnim = null; }
      }

      controls.update();

      const now = performance.now();
      for (let i = pinAnims.length - 1; i >= 0; i--) {
        const a = pinAnims[i];
        const t    = Math.min((now - a.start) / PIN_ANIM_MS, 1);
        const ease = 1 - Math.pow(1 - t, 3);
        a.pin.position.copy(a.startPos).multiplyScalar(1 - ease);
        a.mats.forEach(m => { m.opacity = ease; });
        if (t >= 1) {
          a.pin.position.set(0, 0, 0);
          a.mats.forEach(m => { m.opacity = 1; });
          pinAnims.splice(i, 1);
        }
      }

      if (arcAnim) {
        const el = performance.now() - arcAnim.start;
        if (arcAnim.both) {
          const t0 = Math.min(el / ARC_DRAW_MS, 1);
          if (arcEntries.cameraToHighlight)
            arcEntries.cameraToHighlight.tubeGeo.setDrawRange(0, Math.floor(t0 * arcEntries.cameraToHighlight.maxIdx));
          const t2 = Math.max(0, Math.min((el - ARC_DRAW_MS - ARC_PAUSE_MS) / ARC_DRAW_MS, 1));
          if (arcEntries.highlightToLight)
            arcEntries.highlightToLight.tubeGeo.setDrawRange(0, Math.floor(t2 * arcEntries.highlightToLight.maxIdx));
          const t3 = Math.max(0, Math.min((el - 2*ARC_DRAW_MS - ARC_PAUSE_MS) / ARC_FADE_MS, 1));
          if (arcEntries.cameraToHighlight) arcEntries.cameraToHighlight.tickMat.opacity = t3 * ARC_OPACITY;
          if (arcEntries.highlightToLight)  arcEntries.highlightToLight.tickMat.opacity  = t3 * ARC_OPACITY;
          if (el >= 2*ARC_DRAW_MS + ARC_PAUSE_MS + ARC_FADE_MS) arcAnim = null;
        } else {
          const entry = arcEntries.cameraToHighlight ?? arcEntries.highlightToLight!;
          const t0 = Math.min(el / ARC_DRAW_MS, 1);
          entry.tubeGeo.setDrawRange(0, Math.floor(t0 * entry.maxIdx));
          const t1 = Math.max(0, Math.min((el - ARC_DRAW_MS) / ARC_FADE_MS, 1));
          entry.tickMat.opacity = t1 * ARC_OPACITY;
          if (el >= ARC_DRAW_MS + ARC_FADE_MS) arcAnim = null;
        }
      }

      renderer.setScissorTest(false);
      renderer.setViewport(0, 0, window.innerWidth, window.innerHeight);
      renderer.render(scene, camera);

      (Object.keys(pins) as PinType[]).forEach(type => {
        const anchor = pinLabelAnchors[type];
        const pin    = pins[type];
        if (!anchor || !pin) return;
        const proj = anchor.clone().add(pin.position).project(camera);
        const el   = pinLabelEls[type];
        el.style.left = `${(proj.x + 1) / 2 * window.innerWidth - 6}px`;
        el.style.top  = `${(-proj.y + 1) / 2 * window.innerHeight + 8}px`;
      });

      gizmoSphere.quaternion.copy(camera.quaternion).invert();
      renderer.setScissorTest(true);
      renderer.setScissor(window.innerWidth - GIZMO, window.innerHeight - GIZMO, GIZMO, GIZMO);
      renderer.setViewport(window.innerWidth - GIZMO, window.innerHeight - GIZMO, GIZMO, GIZMO);
      renderer.render(axesScene, axesCamera);
      renderer.setScissorTest(false);
    }
    animate();
  </script>

</DemoLayout>
