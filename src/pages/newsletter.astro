---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Newsletter">
  <article class="post">
    <img src="/workshops/assets/images/hero.jpg" alt="Hero image" />

    <h2>Email newsletter</h2>
    <p>Get notified of new workshops, classes, and resources</p>

    <div class="signup-form-container">
      <div id="mc_embed_shell">
        <div id="mc_embed_signup">
          <form action="https://timdoseart.us21.list-manage.com/subscribe/post?u=a57e2576b59e8474c1ce01b33&id=478fea74c6&f_id=002e09e1f0" method="post" id="mc-embedded-subscribe-form" name="mc-embedded-subscribe-form" class="validate" target="_self" novalidate>
            <div id="mc_embed_signup_scroll">
              <h4>Subscribe now &amp; get a free video lesson</h4>
              <div class="mc-field-group">
                <label for="mce-EMAIL">Email Address</label>
                <input type="email" name="EMAIL" class="required email" id="mce-EMAIL" required value="" />
              </div>
              <div hidden>
                <input type="hidden" name="tags" value="2877673" />
              </div>
              <div id="mce-responses" class="clear">
                <div class="response" id="mce-error-response" style="display: none;"></div>
                <div class="response" id="mce-success-response" style="display: none;"></div>
              </div>
              <div aria-hidden="true" style="position: absolute; left: -5000px;">
                <input type="text" name="b_a57e2576b59e8474c1ce01b33_478fea74c6" tabindex="-1" value="" />
              </div>
              <div class="button-container">
                <input type="submit" name="subscribe" id="mc-embedded-subscribe" class="button" value="Subscribe" />
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
