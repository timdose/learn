  <DiscountPopup discount1={discount1} discount2={discount2} />
  <WaitlistPopup pageTitle={title} registrationOpen={registrationOpen} />
  <TimePreferencePopup pageTitle={title} possibleTimes={possibleTimes} />
  <script src="/workshops/assets/waitlist.js" is:inline></script>
</body>
</html>
