---
import PaypalButton from './PaypalButton.astro';

interface Props {
  price: number;
  discount?: number;
  itemName: string;
  registrationOpen?: boolean;
  purchaseReturnUrl?: string;
  pageTitle: string;
  pageUrl: string;
  askTimes?: boolean;
}
const { price, discount, itemName, registrationOpen, purchaseReturnUrl = '/', pageTitle, pageUrl, askTimes } = Astro.props;

const finalPrice = discount ? Math.round(price * (1 - discount / 100)) : price;
---
{registrationOpen ? (
  <>
    {discount ? (
      <h1 class="style7">
        <div class="discounted-price">${finalPrice}</div>
        <div class="original-price">${price}</div>
      </h1>
    ) : (
      <h1 class="style7">${finalPrice}</h1>
    )}
    <PaypalButton
      price={finalPrice}
      itemName={itemName}
      pageTitle={pageTitle}
      purchaseReturnUrl={purchaseReturnUrl}
      pageUrl={pageUrl}
    />
  </>
) : (
  <div class="waitlist-container">
    <button
      class="waitlist-button button"
      data-price={finalPrice}
      data-item-name={itemName}
      data-discount={discount ?? ''}
      data-original-price={price}
      {...(askTimes ? { 'data-ask-times': '' } : {})}
    >
      Join waitlist
    </button>
  </div>
)}
