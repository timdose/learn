---
interface Props {
  registrationOpen?: boolean;
  discount1?: number;
  discount2?: number;
}
const { registrationOpen, discount1, discount2 } = Astro.props;
---
{registrationOpen && (
  <div class="discount-sections">
    <div class="callout discount-section show-if-full">
      <p>Sliding scale available</p>
      <button class="openPopup outline medium">Check for discounts</button>
    </div>
    <div class="callout discount-section show-if-discount1 hidden">
      <p>Sliding scale discount: <strong>{discount1}% off</strong></p>
      <button class="openPopup outline medium">Change</button>
    </div>
    <div class="callout discount-section show-if-discount2 hidden">
      <p>Sliding scale discount: <strong>{discount2}% off</strong></p>
      <button class="openPopup outline medium">Change</button>
    </div>
  </div>
)}
