#! /bin/bash

JEKYLL_ENV=production bundle exec jekyll build --destination _build

# Add all files in _build directory
cd _build
git add .

# Create commit message with current date and time
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
git commit -m "build & deploy: $TIMESTAMP"

# Go back to root and push
cd ..
git push prod main