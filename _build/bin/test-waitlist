#!/bin/bash

# Default values
TIMESTAMP=$(date '+%Y%m%d_%H%M%S')
EMAIL="test+${TIMESTAMP}@example.com"
COURSE="Test Course"
ITEM="Test Item"
PRICE="99.99"

# Production URL
URL="https://learn.timdoseart.com/workshops/process_waitlist.php"

echo "Testing waitlist submission..."
curl -X POST $URL \
  -d "email=$EMAIL" \
  -d "courseName=$COURSE" \
  -d "itemName=$ITEM" \
  -d "price=$PRICE"

echo -e "\nDone!"
