#!/bin/bash

# Make the script executable
chmod +x "$0"

URL="https://learn.timdoseart.com/workshops/process_time_preference.php"

echo "Testing time preference submission..."
echo "-------------------"

curl -X POST $URL \
  -H "Content-Type: application/json" \
  -d '{
    "email": "test@example.com",
    "timePreference": ["morning", "afternoon"],
    "otherTimes": "Weekends preferred"
  }'
echo -e "\n-------------------"
